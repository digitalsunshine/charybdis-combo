#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 2>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp ESC            &kp N1  &kp N2  &kp N3            &kp N4        &kp N5          &kp N6      &kp N7           &kp N8  &kp N9   &kp N0     &to 1
&kp TAB            &kp Y   &kp P   &kp O             &kp U         &kp J           &kp C       &kp K            &kp L   &kp D    &kp W      &kp FSLH
&kp APOS           &kp I   &kp N   &kp E             &kp A         &kp MINUS       &kp H       &kp M            &kp T   &kp S    &kp R      &kp SEMI
&mt LEFT_GUI CAPS  &kp Q   &kp Z   &kp COMMA         &kp DOT       &kp G           &kp B       &lt 3 F          &kp X   &lt 4 V  &mkp LCLK  &mkp RCLK
                                   &kp LEFT_CONTROL  &kp SPACE     &mo 1           &kp DELETE  &lt 2 BACKSPACE
                                                     &kp LEFT_WIN  &kp LEFT_ALT    &kp ENTER
            >;
        };

        combo {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6        &kp F7     &kp F8     &kp F9  &kp F10  &kp F11    &to 0
&none   &none   &kp P   &kp O   &kp U   &none         &none      &kp K      &kp L   &kp D    &none      &none
&none   &kp I   &kp N   &kp E   &kp A   &none         &none      &kp M      &kp T   &kp S    &kp R      &none
&none   &none   &none   &none   &none   &none         &none      &mo 3      &none   &none    &mkp LCLK  &mkp RCLK
                        &none   &none   &To0_macro    &mkp LCLK  &mkp RCLK
                                &none   &none         &none
            >;
        };

        numbers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3     &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans   &trans
&trans  &trans          &kp PAGE_UP     &kp UP_ARROW    &kp PAGE_DOWN    &trans          &trans      &kp N7  &kp N8  &kp N9  &trans   &trans
&trans  &bt BT_CLR_ALL  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans          &trans      &kp N4  &kp N5  &kp N6  &kp N0   &trans
&trans  &trans          &trans          &bt BT_CLR      &trans           &trans          &bt BT_NXT  &kp N1  &kp N2  &kp N3  &kp DOT  &trans
                                        &trans          &trans           &trans          &trans      &trans
                                                        &trans           &trans          &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &mkp MCLK
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &mkp LCLK  &mkp RCLK
                                &trans  &trans    &trans
            >;
        };

        misc1 {
            bindings = <
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &to 0
&none  &none  &kp P  &kp O  &kp U  &none    &none  &kp K  &kp L  &kp B  &none  &none
&none  &kp I  &kp N  &kp E  &kp A  &none    &none  &kp M  &kp T  &kp S  &kp R  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
                     &none  &none  &none    &none  &none
                            &none  &none    &none
            >;
        };
    };
};
